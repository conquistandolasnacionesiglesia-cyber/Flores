<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Te amo 🌻</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Quicksand:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --cielo1:#160d2b;
    --cielo2:#3a1f5e;
    --cielo3:#7d4a8a;
    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  *,*::before,*::after{box-sizing:inherit}
  html,body{height:100%;margin:0}
  body{
    font-family:'Quicksand',system-ui,-apple-system,sans-serif;
    background:radial-gradient(circle at 50% 22%,var(--cielo3) 0%,var(--cielo2) 42%,var(--cielo1) 100%);
    color:#fff6dd;overflow:hidden;position:relative;
  }

  /* ---------- escena ---------- */
  .escenario{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;overflow:hidden}
  .camara{
    width:min(100%,460px);
    transform-origin:50% 32%;
    transform:scale(.5);
    transition:transform 2.6s cubic-bezier(.4,0,.2,1),opacity .9s ease;
  }
  .camara.f1{transform:scale(1.05)}
  .camara.f2{transform:scale(1.18) translateY(-27%);transition-duration:5s;transition-timing-function:linear}
  .camara.f3{transform:scale(.72) translateY(-6%);transition-duration:2s}
  .camara.oculta{opacity:0;transform:scale(.55) translateY(-6%);transition-duration:1.1s}
  .camara svg{display:block;width:100%;height:auto}

  .brote{
    transform:scale(0) rotate(-50deg);opacity:0;
    transition:transform .65s cubic-bezier(.34,1.56,.64,1),opacity .45s ease;
  }
  .brote.abierta{transform:scale(1) rotate(0);opacity:1}

  /* ---------- fondo animado ---------- */
  .estrella{position:fixed;border-radius:50%;background:#fff;animation:titilar 3s ease-in-out infinite;pointer-events:none}
  @keyframes titilar{0%,100%{opacity:.12}50%{opacity:.95}}

  .polen{
    position:fixed;border-radius:50%;pointer-events:none;
    background:radial-gradient(circle,#fff3b0,rgba(255,214,61,0));
    animation:subirPolen linear infinite;
  }
  @keyframes subirPolen{
    0%{transform:translateY(15vh) scale(.5);opacity:0}
    18%{opacity:.9}
    100%{transform:translateY(-112vh) translateX(var(--dx,20px)) scale(1.3);opacity:0}
  }

  /* lluvia de flores del final */
  .lluvia{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:4;opacity:0;transition:opacity 1.2s ease}
  .lluvia.on{opacity:1}
  .cae{position:absolute;top:-14vh;animation:caer linear infinite}
  .cae svg{animation:girar 5s linear infinite}
  @keyframes caer{to{transform:translateY(122vh) translateX(var(--dx,30px))}}
  @keyframes girar{to{transform:rotate(360deg)}}

  /* ---------- explosión ---------- */
  .boom{position:fixed;inset:0;z-index:6;pointer-events:none}
  .chispa{
    position:absolute;left:50%;top:var(--cy,46%);
    transform:translate(-50%,-50%) scale(0);
    opacity:0;
    transition:transform 1.15s cubic-bezier(.22,1.4,.36,1),opacity .4s ease;
  }
  .chispa.fuera{opacity:1}
  .chispa .giro{display:block;animation:latido 2.6s ease-in-out infinite}
  @keyframes latido{0%,100%{transform:scale(1) rotate(0)}50%{transform:scale(1.16) rotate(8deg)}}

  .onda{
    position:fixed;left:50%;top:var(--cy,46%);
    width:20px;height:20px;margin:-10px 0 0 -10px;
    border-radius:50%;border:3px solid rgba(255,229,127,.85);
    opacity:0;z-index:5;pointer-events:none;
  }
  .onda.go{animation:expandir 1.5s ease-out forwards}
  @keyframes expandir{
    0%{opacity:.95;transform:scale(.2)}
    100%{opacity:0;transform:scale(42)}
  }
  .flash{position:fixed;inset:0;background:#fff8d6;opacity:0;z-index:7;pointer-events:none}
  .flash.go{animation:destello .6s ease-out forwards}
  @keyframes destello{0%{opacity:.85}100%{opacity:0}}

  /* ---------- texto ---------- */
  .mensaje{
    position:fixed;left:0;right:0;top:var(--cy,46%);
    transform:translateY(-50%);
    z-index:8;text-align:center;padding:0 18px;
    opacity:0;transition:opacity 1.2s ease;pointer-events:none;
  }
  .mensaje.visible{opacity:1}
  .mensaje h1{
    font-family:'Great Vibes',cursive;font-weight:400;
    font-size:clamp(3.6rem,19vw,7.5rem);line-height:.95;margin:0;
    color:#fff3b0;
    text-shadow:0 0 26px rgba(255,214,61,.85),0 0 60px rgba(255,160,0,.5),0 6px 20px rgba(0,0,0,.45);
    animation:latir 2.8s ease-in-out infinite;
  }
  @keyframes latir{0%,100%{transform:scale(1)}50%{transform:scale(1.07)}}
  .mensaje p{max-width:19rem;margin:.7em auto 0;font-size:clamp(.95rem,4.1vw,1.1rem);line-height:1.6;opacity:.93}

  .pie{
    position:fixed;left:0;right:0;bottom:calc(22px + env(safe-area-inset-bottom,0px));
    z-index:9;text-align:center;opacity:0;transition:opacity 1s ease;
  }
  .pie.visible{opacity:1}
  .btn{
    border:1px solid rgba(255,229,127,.5);background:rgba(255,229,127,.15);
    color:#ffe98a;font-family:inherit;font-size:1rem;font-weight:600;
    padding:.7em 1.6em;border-radius:999px;cursor:pointer;
    transition:transform .15s ease,background .2s ease;
  }
  .btn:active{transform:scale(.94)}
  .btn:hover{background:rgba(255,229,127,.28)}

  .corazon{position:fixed;font-size:1.7rem;pointer-events:none;z-index:10;animation:subir 2.2s ease-out forwards}
  @keyframes subir{0%{opacity:1;transform:translateY(0) scale(.6)}100%{opacity:0;transform:translateY(-175px) scale(1.4)}}

  @media (prefers-reduced-motion: reduce){
    .camara,.brote,.chispa{transition-duration:.01s}
    .estrella,.polen,.cae,.cae svg,.mensaje h1,.chispa .giro{animation:none}
  }
</style>
</head>
<body>

<div class="escenario">
  <div class="camara" id="camara">
    <svg viewBox="0 0 400 760" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="torre" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#5d4a6b"/><stop offset="45%" stop-color="#8d789c"/><stop offset="100%" stop-color="#483859"/>
        </linearGradient>
        <linearGradient id="pelo" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffe680"/><stop offset="60%" stop-color="#ffd93d"/><stop offset="100%" stop-color="#f0b429"/>
        </linearGradient>
        <radialGradient id="luzVentana">
          <stop offset="0%" stop-color="#ffeaa8" stop-opacity=".95"/><stop offset="100%" stop-color="#ffb74d" stop-opacity="0"/>
        </radialGradient>
        <linearGradient id="vestido" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#bb8ad8"/><stop offset="100%" stop-color="#7e57a8"/>
        </linearGradient>
      </defs>

      <circle cx="322" cy="94" r="30" fill="#fff6dd" opacity=".85"/>
      <circle cx="310" cy="86" r="28" fill="#3a1f5e" opacity=".6"/>

      <path d="M118 200 L200 116 L282 200 Z" fill="#6a4a7d"/>
      <path d="M200 116 L200 98" stroke="#ffd93d" stroke-width="4" stroke-linecap="round"/>
      <rect x="128" y="200" width="144" height="560" fill="url(#torre)"/>
      <g opacity=".26" stroke="#2c2036" stroke-width="2">
        <path d="M128 250h144M128 300h144M128 350h144M128 400h144M128 460h144M128 520h144M128 590h144M128 660h144"/>
        <path d="M165 200v50M235 250v50M165 300v50M235 350v50M165 400v60M235 460v60M165 520v70"/>
      </g>

      <!-- enredaderas -->
      <path d="M132 760 C152 640 120 560 150 470 C170 410 140 340 166 276" stroke="#4e8c4a" stroke-width="5" fill="none" opacity=".8"/>
      <path d="M270 760 C250 660 284 580 258 500 C240 440 268 380 244 318" stroke="#4e8c4a" stroke-width="5" fill="none" opacity=".7"/>
      <path d="M100 760 C112 690 96 640 116 590" stroke="#43803f" stroke-width="4" fill="none" opacity=".6"/>
      <path d="M300 760 C288 700 306 650 288 600" stroke="#43803f" stroke-width="4" fill="none" opacity=".6"/>

      <path d="M160 268 A40 40 0 0 1 240 268 L240 320 L160 320 Z" fill="#291a3d"/>
      <circle cx="200" cy="286" r="72" fill="url(#luzVentana)"/>

      <g>
        <path d="M172 262 C172 232 228 232 228 262 L228 300 L172 300 Z" fill="#f0b429"/>
        <path d="M178 292 C176 310 174 318 172 322 L228 322 C226 316 224 308 222 292 Z" fill="url(#vestido)"/>
        <path d="M176 312 h48" stroke="#f3c9a0" stroke-width="7" stroke-linecap="round"/>
        <circle cx="200" cy="268" r="17" fill="#f7d5b0"/>
        <path d="M183 264 C180 250 192 240 200 240 C208 240 220 250 217 264 C214 250 186 250 183 264 Z" fill="#ffe680"/>
        <circle cx="194" cy="270" r="1.9" fill="#3b2a1a"/>
        <circle cx="207" cy="270" r="1.9" fill="#3b2a1a"/>
        <path d="M196 277 q4.5 3.6 9 0" stroke="#c4795c" stroke-width="1.7" fill="none" stroke-linecap="round"/>
        <circle cx="189" cy="275" r="2.6" fill="#ff9a9e" opacity=".5"/>
        <circle cx="212" cy="275" r="2.6" fill="#ff9a9e" opacity=".5"/>
      </g>

      <path d="M200 300 Q238 340 200 380 Q162 420 200 460 Q238 500 200 540 Q162 580 200 620 Q238 660 200 700 Q180 730 196 758"
            stroke="url(#pelo)" stroke-width="18" fill="none" stroke-linecap="round"/>
      <path d="M200 300 Q238 340 200 380 Q162 420 200 460 Q238 500 200 540 Q162 580 200 620 Q238 660 200 700 Q180 730 196 758"
            stroke="#fff3b0" stroke-width="5" fill="none" stroke-linecap="round" opacity=".5"/>
      <g fill="#f0b429" opacity=".5">
        <ellipse cx="218" cy="341" rx="9" ry="5" transform="rotate(35 218 341)"/>
        <ellipse cx="182" cy="421" rx="9" ry="5" transform="rotate(-35 182 421)"/>
        <ellipse cx="218" cy="501" rx="9" ry="5" transform="rotate(35 218 501)"/>
        <ellipse cx="182" cy="581" rx="9" ry="5" transform="rotate(-35 182 581)"/>
        <ellipse cx="218" cy="661" rx="9" ry="5" transform="rotate(35 218 661)"/>
      </g>

      <g id="flores"></g>
    </svg>
  </div>
</div>

<div class="lluvia" id="lluvia"></div>
<div class="boom" id="boom"></div>
<div class="onda" id="onda"></div>
<div class="flash" id="flash"></div>

<div class="mensaje" id="mensaje">
  <h1>Te amo</h1>
  <p>Todas las flores amarillas del mundo son pocas para ti 🌻</p>
</div>

<div class="pie" id="pie">
  <button class="btn" id="repetir">Verlo otra vez 💛</button>
</div>

<script>
  const NS='http://www.w3.org/2000/svg';
  const tonos=[['#ffd93d','#ffb300'],['#ffe57f','#ffc107'],['#fdd835','#f9a825'],['#ffeb8a','#ffa000']];

  /* ---- generador de flor (SVG string) ---- */
  function flor(tam,par){
    const [c1,c2]=tonos[par%tonos.length];
    const n=par%2?6:8; let p='';
    for(let k=0;k<n;k++){
      p+=`<ellipse cx="0" cy="${-tam*0.28}" rx="${tam*0.17}" ry="${tam*0.32}" fill="${k%2?c1:c2}" transform="rotate(${k*(360/n)})"/>`;
    }
    return `<svg width="${tam}" height="${tam}" viewBox="${-tam/2} ${-tam/2} ${tam} ${tam}" xmlns="${NS}">
      ${p}<circle r="${tam*0.17}" fill="#8d5524"/><circle r="${tam*0.1}" fill="#5d3a18"/></svg>`;
  }

  /* ---- estrellas y polen ---- */
  for(let i=0;i<70;i++){
    const s=document.createElement('div');s.className='estrella';
    const t=Math.random()*2.4+1;s.style.width=s.style.height=t+'px';
    s.style.left=Math.random()*100+'vw';s.style.top=Math.random()*78+'vh';
    s.style.animationDelay=(-Math.random()*3)+'s';document.body.appendChild(s);
  }
  for(let i=0;i<26;i++){
    const p=document.createElement('div');p.className='polen';
    const t=4+Math.random()*10;p.style.width=p.style.height=t+'px';
    p.style.left=Math.random()*100+'vw';p.style.bottom='-10vh';
    p.style.animationDuration=(9+Math.random()*10)+'s';
    p.style.animationDelay=(-Math.random()*14)+'s';
    p.style.setProperty('--dx',(Math.random()*130-65)+'px');
    document.body.appendChild(p);
  }

  /* ---- flores de la escena (trenza, pelo, enredaderas, torre) ---- */
  const puntos=[
    // en su cabello
    {x:184,y:254,r:14},{x:216,y:254,r:13},{x:200,y:243,r:11},{x:172,y:266,r:10},{x:229,y:266,r:10},
    // trenza
    {x:218,y:341,r:16},{x:208,y:360,r:11},{x:200,y:380,r:14},{x:190,y:400,r:11},
    {x:182,y:421,r:16},{x:190,y:441,r:11},{x:200,y:460,r:14},{x:210,y:480,r:11},
    {x:218,y:501,r:16},{x:212,y:521,r:11},{x:200,y:540,r:14},{x:190,y:560,r:11},
    {x:182,y:581,r:16},{x:189,y:601,r:11},{x:200,y:620,r:15},{x:210,y:641,r:11},
    {x:218,y:661,r:16},{x:211,y:681,r:11},{x:200,y:700,r:14},{x:189,y:722,r:12},
    {x:172,y:742,r:17},{x:224,y:734,r:15},
    // enredaderas y base
    {x:150,y:470,r:13},{x:140,y:560,r:15},{x:132,y:650,r:13},{x:120,y:720,r:16},
    {x:258,y:500,r:13},{x:266,y:590,r:15},{x:276,y:670,r:13},{x:286,y:730,r:16},
    {x:98,y:744,r:14},{x:308,y:748,r:14},{x:244,y:320,r:12},{x:166,y:280,r:11},
    // en la torre
    {x:148,y:360,r:10},{x:252,y:410,r:10},{x:146,y:640,r:10},{x:254,y:290,r:10}
  ];
  const cont=document.getElementById('flores');
  const brotes=puntos.map((p,i)=>{
    const [c1,c2]=tonos[i%tonos.length];
    const g=document.createElementNS(NS,'g');
    g.setAttribute('class','brote');
    g.setAttribute('transform',`translate(${p.x} ${p.y})`);
    g.style.transformOrigin=`${p.x}px ${p.y}px`;
    const n=i%2?6:8;let pet='';
    for(let k=0;k<n;k++){
      pet+=`<ellipse cx="0" cy="${-p.r*0.55}" rx="${p.r*0.33}" ry="${p.r*0.62}" fill="${k%2?c1:c2}" transform="rotate(${k*(360/n)})"/>`;
    }
    g.innerHTML=pet+`<circle r="${p.r*0.33}" fill="#8d5524"/><circle r="${p.r*0.2}" fill="#5d3a18"/>`;
    cont.appendChild(g);return g;
  });

  /* ---- lluvia de flores ---- */
  const lluvia=document.getElementById('lluvia');
  const nCae=window.innerWidth<600?22:38;
  for(let i=0;i<nCae;i++){
    const d=document.createElement('div');d.className='cae';
    d.innerHTML=flor(14+Math.random()*26,i);
    d.style.left=Math.random()*100+'vw';
    d.style.animationDuration=(7+Math.random()*9)+'s';
    d.style.animationDelay=(-Math.random()*12)+'s';
    d.style.setProperty('--dx',(Math.random()*140-70)+'px');
    d.querySelector('svg').style.animationDuration=(3+Math.random()*5)+'s';
    lluvia.appendChild(d);
  }

  /* ---- explosión en forma de corazón ---- */
  const boom=document.getElementById('boom');
  const chispas=[];
  function armarCorazon(){
    boom.innerHTML='';chispas.length=0;
    const S=Math.min(window.innerWidth*0.86,window.innerHeight*0.62)/34;
    const capas=[{k:1,n:40,t:26},{k:.72,n:26,t:21},{k:.45,n:16,t:17},{k:.2,n:8,t:14}];
    let idx=0;
    capas.forEach(capa=>{
      for(let i=0;i<capa.n;i++){
        const t=(i/capa.n)*Math.PI*2;
        const hx=16*Math.pow(Math.sin(t),3);
        const hy=13*Math.cos(t)-5*Math.cos(2*t)-2*Math.cos(3*t)-Math.cos(4*t);
        const x=hx*S*capa.k, y=-hy*S*capa.k;
        const d=document.createElement('div');
        d.className='chispa';
        const tam=capa.t*(.8+Math.random()*.5);
        d.innerHTML=`<span class="giro">${flor(tam,idx)}</span>`;
        d.dataset.x=x;d.dataset.y=y;
        d.style.transitionDelay=(idx*11)+'ms';
        d.querySelector('.giro').style.animationDelay=(Math.random()*2)+'s';
        boom.appendChild(d);chispas.push(d);idx++;
      }
    });
  }
  armarCorazon();
  addEventListener('resize',()=>{armarCorazon();});

  function estallar(){
    chispas.forEach(d=>{
      const r=(Math.random()*24-12);
      d.classList.add('fuera');
      d.style.transform=`translate(calc(-50% + ${d.dataset.x}px), calc(-50% + ${d.dataset.y}px)) scale(1) rotate(${r}deg)`;
    });
  }
  function recoger(){
    chispas.forEach(d=>{d.classList.remove('fuera');d.style.transform='translate(-50%,-50%) scale(0)';});
  }

  /* ---- timeline ---- */
  const camara=document.getElementById('camara');
  const mensaje=document.getElementById('mensaje');
  const pie=document.getElementById('pie');
  const onda=document.getElementById('onda');
  const flash=document.getElementById('flash');
  let timers=[];
  const espera=(fn,ms)=>timers.push(setTimeout(fn,ms));

  function reproducir(){
    timers.forEach(clearTimeout);timers=[];
    camara.className='camara';
    mensaje.classList.remove('visible');
    pie.classList.remove('visible');
    lluvia.classList.remove('on');
    onda.classList.remove('go');flash.classList.remove('go');
    brotes.forEach(b=>b.classList.remove('abierta'));
    recoger();

    espera(()=>camara.classList.add('f1'),350);
    espera(()=>{
      camara.classList.add('f2');
      brotes.forEach((b,i)=>espera(()=>b.classList.add('abierta'),i*130));
    },3100);
    espera(()=>{camara.classList.remove('f1','f2');camara.classList.add('f3');},9200);
    espera(()=>{
      camara.classList.add('oculta');
      flash.classList.add('go');
      onda.classList.add('go');
      estallar();
    },11000);
    espera(()=>lluvia.classList.add('on'),11300);
    espera(()=>mensaje.classList.add('visible'),12300);
    espera(()=>pie.classList.add('visible'),13200);
  }
  reproducir();
  document.getElementById('repetir').addEventListener('click',e=>{e.stopPropagation();reproducir();});

  /* ---- corazones al tocar ---- */
  const emojis=['💛','🌻','✨','💫','💐'];
  document.body.addEventListener('click',e=>{
    if(e.target.id==='repetir')return;
    for(let i=0;i<7;i++){
      const c=document.createElement('div');c.className='corazon';
      c.textContent=emojis[Math.floor(Math.random()*emojis.length)];
      c.style.left=(e.clientX+(Math.random()*90-45))+'px';
      c.style.top=e.clientY+'px';
      c.style.animationDelay=(Math.random()*.35)+'s';
      document.body.appendChild(c);
      setTimeout(()=>c.remove(),2600);
    }
  });
</script>
</body>
</html>
